# Copy this to .env.local, or run npm run setup to generate local secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
WORKSPACE_PASSWORD=
SESSION_SECRET=
WORKSPACE_ID=workspace-owner
# Set to 1 on hosts without persistent storage (including Render Free).
EPHEMERAL_STORAGE=0

# Local development uses the included Python service. On Vercel, use its HTTPS Render URL.
PYTHON_API_URL=http://127.0.0.1:8000
# Same value as SERVICE_TOKEN on a separately deployed Python backend.
PYTHON_SERVICE_TOKEN=

# Optional authorized ad collection service.
AD_LIBRARY_API_URL=
AD_LIBRARY_API_KEY=
